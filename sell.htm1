<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CARDÉ — Sell Your Card</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, "Noto Sans KR", sans-serif;
      color: #111;
      background: #fff;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    header {
      height: 82px;
      border-bottom: 1px solid #e8e8e8;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 6%;
    }

    .logo {
      font-size: 23px;
      font-weight: 600;
      letter-spacing: 6px;
    }

    nav {
      display: flex;
      gap: 38px;
      font-size: 12px;
      letter-spacing: 1.5px;
    }

    nav a:hover {
      opacity: 0.45;
    }

    .header-right {
      display: flex;
      gap: 22px;
      font-size: 12px;
    }

    .page {
      max-width: 900px;
      margin: auto;
      padding: 90px 25px 120px;
    }

    .title {
      text-align: center;
      margin-bottom: 70px;
    }

    .title small {
      display: block;
      font-size: 10px;
      letter-spacing: 4px;
      color: #888;
      margin-bottom: 20px;
    }

    .title h1 {
      font-size: 42px;
      font-weight: 400;
      letter-spacing: 5px;
      margin-bottom: 18px;
    }

    .title p {
      color: #777;
      font-size: 13px;
    }

    .form {
      border-top: 1px solid #111;
    }

    .row {
      display: grid;
      grid-template-columns: 180px 1fr;
      min-height: 85px;
      border-bottom: 1px solid #e5e5e5;
      align-items: center;
    }

    .label {
      font-size: 12px;
      letter-spacing: 1px;
    }

    input,
    select,
    textarea {
      width: 100%;
      border: 1px solid #ddd;
      padding: 15px;
      font-size: 13px;
      background: white;
      outline: none;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: #111;
    }

    textarea {
      min-height: 140px;
      resize: vertical;
    }

    .image-box {
      border: 1px dashed #ccc;
      padding: 35px;
      text-align: center;
      color: #888;
      font-size: 12px;
    }

    .image-box input {
      border: none;
      padding: 20px 0 0;
    }

    .submit-area {
      text-align: center;
      margin-top: 60px;
    }

    button {
      border: none;
      background: #111;
      color: white;
      padding: 18px 60px;
      font-size: 11px;
      letter-spacing: 2px;
      cursor: pointer;
    }

    button:hover {
      background: #333;
    }

    footer {
      background: #111;
      color: #888;
      padding: 55px 6%;
      font-size: 10px;
      line-height: 2;
    }

    .footer-logo {
      color: white;
      font-size: 18px;
      letter-spacing: 5px;
      margin-bottom: 15px;
    }

    @media (max-width: 800px) {

      header {
        padding: 0 20px;
      }

      nav {
        display: none;
      }

      .header-right {
        display: none;
      }

      .page {
        padding: 60px 20px 90px;
      }

      .title h1 {
        font-size: 34px;
      }

      .row {
        display: block;
        padding: 22px 0;
      }

      .label {
        margin-bottom: 12px;
      }
    }
  </style>
</head>

<body>

<header>

  <a href="index.html" class="logo">
    CARDÉ
  </a>

  <nav>
    <a href="index.html">MARKET</a>
    <a href="index.html#operator">OPERATOR SHOP</a>
    <a href="sell.html">SELL</a>
    <a href="#">ABOUT</a>
  </nav>

  <div class="header-right">
    <span>SEARCH</span>
    <span>♡</span>
    <span>LOGIN</span>
  </div>

</header>


<div class="page">

  <div class="title">

    <small>SELL YOUR CARD</small>

    <h1>LIST YOUR CARD</h1>

    <p>
      Share your card with collectors around the world.
    </p>

  </div>


  <div class="form">

    <div class="row">

      <div class="label">
        CATEGORY
      </div>

      <div>
        <select>
          <option>Pokémon</option>
          <option>ONE PIECE</option>
          <option>Weiss Schwarz</option>
          <option>Other</option>
        </select>
      </div>

    </div>


    <div class="row">

      <div class="label">
        CARD NAME
      </div>

      <div>
        <input
          type="text"
          placeholder="Enter card name"
        >
      </div>

    </div>


    <div class="row">

      <div class="label">
        PRICE
      </div>

      <div>
        <input
          type="number"
          placeholder="₩ Enter price"
        >
      </div>

    </div>


    <div class="row">

      <div class="label">
        CONDITION
      </div>

      <div>
        <select>
          <option>Mint</option>
          <option>Near Mint</option>
          <option>Excellent</option>
          <option>Good</option>
          <option>Played</option>
        </select>
      </div>

    </div>


    <div class="row">

      <div class="label">
        CARD IMAGE
      </div>

      <div class="image-box">

        Upload your card images

        <input
          type="file"
          accept="image/*"
          multiple
        >

      </div>

    </div>


    <div class="row">

      <div class="label">
        DESCRIPTION
      </div>

      <div>

        <textarea
          placeholder="Describe your card..."
        ></textarea>

      </div>

    </div>

  </div>


  <div class="submit-area">

    <button onclick="submitCard()">
      LIST CARD
    </button>

  </div>

</div>


<footer>

  <div class="footer-logo">
    CARDÉ
  </div>

  <p>
    A Curated Card Market for Your Collection
  </p>

  <p>
    © 2026 CARDÉ. All Rights Reserved.
  </p>

</footer>


<script>

function submitCard() {

  alert(
    "Your card listing has been prepared.\n\n" +
    "The actual listing system will be connected later."
  );

}

</script>

</body>
</html>
